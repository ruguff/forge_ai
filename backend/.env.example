# ProjectForge AI — Environment Variables
# Copy this file to .env and fill in your values.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
# For offline mode: set LLM_PROVIDER=lmstudio and start LM Studio's local server.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL_NAME=nvidia/nemotron-3-nano-4b
# LM Studio with Nemotron: disables its reasoning trace so JSON gets the output allowance.
# Leave empty for a runtime/model that does not support reasoning_effort.
LOCAL_MODEL_REASONING_EFFORT=
# Supported low-memory offline strategy. MODEL_CODE remains the online/freeform path.
LOCAL_CODE_GENERATION_STRATEGY=declarative_crud
MAX_MODEL_CALLS=40
MODEL_TIMEOUT_SECONDS=90
DATABASE_URL=sqlite+aiosqlite:///./projectforge.db
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
