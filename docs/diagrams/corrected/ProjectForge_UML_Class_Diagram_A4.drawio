        <mxCell id="note-0" value="build_spec is an optional serialized dict, not a stored BuildSpec instance. No object association is asserted." style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Times New Roman;fontSize=16;align=left;verticalAlign=middle;spacing=5;fontSize=14;" vertex="1" parent="1">
