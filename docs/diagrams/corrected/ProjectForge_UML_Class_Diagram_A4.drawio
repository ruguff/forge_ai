        </mxCell>
        <mxCell id="note-1" value="Persistence serializes state/context/spec. Nested lists use associations; exclusive lifecycle ownership is not enforced." style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Times New Roman;fontSize=16;align=left;verticalAlign=middle;spacing=5;fontSize=14;" vertex="1" parent="1">
